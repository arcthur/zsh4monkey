#!/usr/bin/env zsh
#
# Restore the z4m cache after a failed or interrupted `z4m update`.
#
# Usage:
#   -z4m-recover-update <root> <guard> <recovery-lock> <backup> <candidate>
#
# Two callers must observe identical semantics: -z4m-cmd-update (in-process
# rollback and stale-transaction recovery) and the temporary bootstrap written
# by -z4m-write-update-bootstrap. The algorithm therefore lives here only; the
# temporary bootstrap autoloads this file from the backup snapshot and falls
# back to the active tree.
#
# The caller must already hold the update recovery lock. Only `command` external
# utilities are used so the temporary bootstrap does not need zsh/files.

emulate -L zsh -o typeset_silent -o extended_glob -o no_aliases

(( ARGC == 5 )) || return 1

local root=$1 guard=$2 recovery_lock=$3 backup=$4 candidate=$5
local entry

if [[ ! -e $backup/zsh4monkey && -r $root/zsh4monkey/main.zsh &&
      -r $backup/z4m.zsh ]]; then
  # The new tree is already active and only the bootstrap entry point is
  # missing. Roll forward instead of discarding a complete installation.
  command cp -p -- $backup/z4m.zsh $root/z4m.zsh || return
else
  [[ -r $backup/z4m.zsh ]] || return 1
  for entry in $root/*(N) $root/.[^.]*(N) $root/..?*(N); do
    [[ $entry == $guard || $entry == $recovery_lock ||
       $entry == $root/z4m.zsh ]] && continue
    command rm -rf -- $entry || return
  done
  for entry in $backup/*(N) $backup/.[^.]*(N) $backup/..?*(N); do
    [[ $entry == $backup/z4m.zsh ]] && continue
    command cp -RP -- $entry $root/${entry:t} || return
  done
  # z4m.zsh is replaced last so an interrupted restore keeps the temporary
  # bootstrap active and the next shell retries from the same backup.
  command cp -p -- $backup/z4m.zsh $root/z4m.zsh || return
fi

[[ -r $root/z4m.zsh ]] || return 1
command rm -f -- $guard || return
# Past this point the cache is usable again, so leftover scratch directories are
# disk noise rather than an incomplete rollback.
command rm -rf -- $backup $candidate 2>/dev/null || true
return 0
