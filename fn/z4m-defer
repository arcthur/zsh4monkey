#!/usr/bin/env zsh
#
# z4m-defer: Queue commands for deferred execution after prompt display
#
# Usage:
#   z4m-defer <command> [arg ...]
#
# Example:
#   z4m-defer source ~/.local/share/slow-plugin/plugin.zsh
#   z4m-defer eval 'eval "$(slow-tool init zsh)"'
#
# Benefits:
#   - User sees prompt immediately
#   - Heavy plugins load in ZLE idle time
#
# Note: z4m already defers syntax-highlighting and compinit internally.
# This is for user plugins that can tolerate delayed loading.
#
# Deferred commands run inside a function: options they set persist, but
# parameters must be declared with `typeset -g` to outlive the call.
#

# Frames that run deferred commands must not use `emulate -L` (local_options
# would revert their setopt); only bookkeeping runs under emulation.

() {
  emulate -L zsh -o typeset_silent

  # Initialize queue on first call
  (( ${+_z4m_defer_queue} )) || typeset -ga _z4m_defer_queue=()
  (( ${+_z4m_defer_next_id} )) || typeset -gi _z4m_defer_next_id=0

  if (( ! ${+functions[_z4m_defer_enqueue]} )); then
    function _z4m_defer_enqueue() {
      emulate -L zsh -o typeset_silent
      (( $# )) || return 1

      local -i id=$(( ++_z4m_defer_next_id ))
      local parameter=_z4m_defer_argv_$id
      typeset -ga "$parameter"
      set -A "$parameter" "$@"
      _z4m_defer_queue+=($id)
    }
  fi

  # Written to work under arbitrary user options; locals are prefixed so that
  # deferred code cannot collide with them.
  if (( ! ${+functions[_z4m_defer_run_queue]} )); then
    function _z4m_defer_run_queue() {
      local -a _z4m_defer_pending=("${_z4m_defer_queue[@]}")
      _z4m_defer_queue=()

      local -i _z4m_defer_id _z4m_defer_rc _z4m_defer_overall_rc=0
      local _z4m_defer_parameter
      local -a _z4m_defer_cmd
      for _z4m_defer_id in "${_z4m_defer_pending[@]}"; do
        _z4m_defer_parameter=_z4m_defer_argv_$_z4m_defer_id
        _z4m_defer_cmd=("${(@P)_z4m_defer_parameter}")
        unset "$_z4m_defer_parameter"
        (( ${#_z4m_defer_cmd} )) || continue

        _z4m_defer_rc=0
        "${_z4m_defer_cmd[@]}" &>/dev/null || _z4m_defer_rc=$?
        if (( _z4m_defer_rc )); then
          _z4m_defer_overall_rc=$_z4m_defer_rc
          () {
            emulate -L zsh
            print -Pru2 -- "%F{3}z4m%f: deferred command failed (%F{1}$1%f): %B${2//\%/%%}%b"
          } $_z4m_defer_rc "${_z4m_defer_cmd[@]:0:1}"
        fi
      done

      return $_z4m_defer_overall_rc
    }
  fi

  # Deferred execution handler
  if (( ! ${+functions[_z4m_defer_execute]} )); then
    function _z4m_defer_execute() {
      # Unregister the fd handler
      local -i _z4m_defer_handler_fd=$1
      zle -F $_z4m_defer_handler_fd
      exec {_z4m_defer_handler_fd}>&-
      unset _z4m_defer_fd

      # Execute all queued commands
      _z4m_defer_run_queue || true

      # Redraw prompt (syntax highlighting may have loaded)
      [[ -o zle ]] && zle && zle reset-prompt 2>/dev/null
      return 0
    }
  fi
}

(( $# )) || return 0

# Add command to queue
_z4m_defer_enqueue "$@" || return

# Schedule execution if not already scheduled
if [[ ! -v _z4m_defer_fd ]]; then
  typeset -gi _z4m_defer_fd
  if zmodload -e zsh/system && sysopen -o cloexec -ru _z4m_defer_fd /dev/null 2>/dev/null; then
    zle -F $_z4m_defer_fd _z4m_defer_execute
  else
    # Fallback: immediate execution if sysopen unavailable
    unset _z4m_defer_fd
    _z4m_defer_run_queue || true
  fi
fi
