#!/usr/bin/env zsh

emulate -L zsh -o typeset_silent -o pipe_fail -o extended_glob \
    -o prompt_percent -o no_prompt_subst -o no_prompt_bang -o no_bg_nice -o no_aliases
-z4m-check-core-params || return

local -a no_restart
zparseopts -D -F -- n=no_restart -no-restart=no_restart || return '_z4m_err()'

if (( ARGC )); then
  print -Pru2 -- '%F{3}z4m%f: unexpected %F{1}update%f argument'
  return '_z4m_err()'
fi

if (( _z4m_dangerous_root )); then
  print -Pru2 -- "%F{3}z4m%f: refusing to %Bupdate%b as %F{1}root%f"
  return 1
fi

local update_url
if ! -z4m-resolve-update-url; then
  print -Pru2 -- "%F{3}z4m%f: failed to resolve update channel"
  return 1
fi
update_url=$REPLY
# The ref becomes a directory name under versions/. The pinned channel returns
# whatever Z4M_URL holds, so validate here rather than relying on the check
# inside sc/activate-version, which only runs after the directory is created.
local update_ref=${update_url:t}
if [[ -z $update_ref || $update_ref == (.|..) || $update_ref == *[^A-Za-z0-9._-]* ]]; then
  print -Pru2 -- "%F{3}z4m%f: unsafe update ref: %F{1}${update_ref//\%/%%}%f"
  return 1
fi
print -Pru2 -- "%F{3}z4m%f: update source %B$update_ref%b"

# The candidate is built in a throwaway cache and only ever enters $Z4M through
# sc/activate-version, which swaps a single symlink. Nothing here has to undo a
# partially replaced framework, because no such state is ever created: a failure
# before activation leaves $Z4M untouched, and a failure after it leaves a
# complete, working version in place.
local staging=$Z4M.staging.$sysparams[pid]
local guard=$Z4M/.updating
local configured_url=$Z4M_URL
local state_configured state_effective state_extra
if [[ -r $Z4M/.update-source ]] &&
   IFS='|' read -r state_configured state_effective state_extra <$Z4M/.update-source &&
   [[ -z $state_extra && $state_effective == $Z4M_URL &&
      $state_configured == https://raw.githubusercontent.com/arcthur/zsh4monkey/* ]]; then
  configured_url=$state_configured
fi
local -i guard_owned=0

function -z4m-cmd-update-write-guard() {
  {
    setopt local_options no_clobber
    print -l -- \
      "pid=$sysparams[pid]" \
      "epoch=$EPOCHSECONDS" >$guard
  } 2>/dev/null
}

function -z4m-cmd-update-acquire-guard() {
  if -z4m-cmd-update-write-guard; then
    guard_owned=1
    return 0
  fi

  # The guard is a plain mutex now. There is no transaction to recover, so a
  # guard whose owner is gone can simply be taken over.
  local existing_pid key value
  if [[ -r $guard ]]; then
    while IFS='=' read -r key value; do
      [[ $key == pid && $value == <-> ]] && existing_pid=$value
    done <$guard
  fi
  if [[ -n $existing_pid ]] && command kill -0 $existing_pid 2>/dev/null; then
    print -Pru2 -- "%F{3}z4m%f: another update is already running with PID %F{1}$existing_pid%f"
    return 1
  fi
  if [[ -n $existing_pid ]]; then
    print -Pru2 -- "%F{3}z4m%f: taking over the guard of exited PID %F{1}$existing_pid%f"
  else
    print -Pru2 -- "%F{3}z4m%f: removing incomplete update guard"
  fi
  zf_rm -f -- $guard || return 1

  if -z4m-cmd-update-write-guard; then
    guard_owned=1
    return 0
  fi
  print -Pru2 -- "%F{3}z4m%f: another update acquired the guard"
  return 1
}

# Everything the updated cache should keep rather than take from the candidate:
# runtime state that belongs to this machine, and the layout entries that
# activation manages.
local -a preserved=(
  versions current z4m.zsh z4m.zsh.zwc zsh4monkey
  cache stickycache tmp bin fn)

{
  -z4m-cmd-update-acquire-guard || return
  zf_rm -rf -- $staging || return
  zf_mkdir -p -- $staging || return
  command cp -p -- $Z4M/z4m.zsh $staging/z4m.zsh || return
  print -n >$staging/.updating || return

  # Full rehearsal: the candidate cache bootstraps the new framework and
  # resolves the install queue exactly as a real shell would. Only a cache that
  # reached a prompt is allowed to become the active one.
  Z4M_URL=$update_url Z4M_UPDATE_SOURCE_URL=$update_url \
    Z4M_UPDATING=$Z4M Z4M=$staging </dev/null >/dev/null $_z4m_exe -ic '
    (( $? )) && "exit" "1"
    "builtin" "emulate" "zsh" "-o" "no_aliases"
    [[ $Z4M == '${(q)staging}' ]] || exit 0
    print -n >$Z4M/tmp/update-successful' || return

  if [[ ! -e $staging/tmp/update-successful ]]; then
    local home=~
    local zdotdir=${${${(q)ZDOTDIR}/#${(q)home}/'~'}//\%/%%}
    print -Pru2 -- '%F{3}z4m%f: %B$Z4M%b %F{1}does not propagate%f through %U.zshrc%u'
    print -Pru2 -- ''
    print -Pru2 -- 'Change %U'$zdotdir'/.zshrc%u to keep %BZ4M%b intact if already set.'
    print -Pru2 -- ''
    print -Pru2 -- 'For example:'
    print -Pru2 -- ''
    print -Pru2 -- '  %F{2}:%f %F{3}"${Z4M:=${XDG_CACHE_HOME:-$HOME/.cache}/zsh4monkey}"%f'
    print -Pru2 -- ''
    print -Pru2 -- 'Note: The leading colon (%F{2}:%f) is necessary.'
    return 1
  fi

  # Resolve rather than inspect the candidate's layout. When the cache being
  # upgraded still runs a pre-versioning z4m.zsh, the rehearsal bootstraps with
  # that older entry point and produces the flat layout; once it runs this
  # version, the same path is a link into the candidate's own versions/. Taking
  # the real path covers both, so upgrading never depends on which bootstrap
  # assembled the candidate.
  local framework=$staging/zsh4monkey
  framework=${framework:A}
  if [[ ! -r $framework/main.zsh || ! -r $framework/z4m.zsh ]]; then
    print -Pru2 -- "%F{3}z4m%f: candidate did not produce a usable framework"
    return 1
  fi

  zf_mkdir -p -- $Z4M/versions || return
  local target_dir
  if (( $+commands[mktemp] )); then
    target_dir=$(command mktemp -d -- $Z4M/versions/$update_ref.XXXXXXXXXX) || return
  else
    target_dir=$Z4M/versions/$update_ref.$sysparams[pid]
    zf_rm -rf -- $target_dir || return
    zf_mkdir -p -- $target_dir || return
  fi
  local target_name=${target_dir:t}
  # mktemp creates the directory 0700; the framework must stay world-readable
  # like every other path a shell resolves through.
  command chmod 755 $target_dir || return
  -z4m-mv $framework $target_dir/zsh4monkey || return
  command cp -p -- $target_dir/zsh4monkey/z4m.zsh $target_dir/z4m.zsh || return

  command sh $Z4M/versions/$target_name/zsh4monkey/sc/activate-version \
    $Z4M $target_name || return

  # Past the switch the cache already runs the new framework. Packages are
  # independent trees, so replacing them one at a time is safe: an interrupted
  # sweep leaves every individual package intact and the next startup resolves
  # whatever is still missing.
  # Visible entries only: every dotfile in the candidate is its own transaction
  # state (.updating, .replaced.*) and must not reach the active cache.
  local entry name
  for entry in $staging/*(N); do
    name=${entry:t}
    (( ${preserved[(Ie)$name]} )) && continue
    if [[ -e $Z4M/$name || -L $Z4M/$name ]]; then
      -z4m-mv $Z4M/$name $staging/.replaced.$name || return
    fi
    -z4m-mv $entry $Z4M/$name || return
  done

  print -r -- "$configured_url|$update_url" >$Z4M/.update-source.$$ || return
  -z4m-mv $Z4M/.update-source.$$ $Z4M/.update-source || return

  # Read into a string first: assigning a user-supplied value to an integer
  # parameter would evaluate it arithmetically and defeat the check below.
  local keep_setting
  local -i keep=2
  if zstyle -s :z4m:update keep-versions keep_setting &&
     [[ $keep_setting == <-> ]] && (( keep_setting >= 1 )); then
    keep=$keep_setting
  fi
  command sh $Z4M/zsh4monkey/sc/prune-versions $Z4M $keep || true
} always {
  local -i rc=$?
  if (( guard_owned )); then
    zf_rm -f -- $guard 2>/dev/null || true
    guard_owned=0
  fi
  zf_rm -rf -- $staging 2>/dev/null || true
  unset "functions[-z4m-cmd-update-acquire-guard]" \
    "functions[-z4m-cmd-update-write-guard]"
  if (( rc )); then
    -z4m-error-command update
  fi
}

print -Pru2 -- "%F{3}z4m%f: %Bupdate successful%b"

# Clear stale state markers so the new version starts from a clean slate.
zf_rm -f -- $Z4M/.last-init-failed $Z4M/.safe-mode 2>/dev/null

if (( $#no_restart )) || [[ ! -o interactive || ! -t 0 || ! -t 1 ]]; then
  return 0
fi

print -Pru2 -- "%F{3}z4m%f: restarting %F{2}zsh%f"
if [[ -o zle ]]; then
  exec -- $_z4m_exe -i || return
else
  exec -- $_z4m_exe -i --no-zle || return
fi
