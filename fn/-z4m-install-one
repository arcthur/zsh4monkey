#!/usr/bin/env zsh

local url postinstall command checksum ref repository owner project
local -i z4m_remote_install_soft_fail=0
[[ -n ${Z4M_SSH-} || -n ${_Z4M_OFFLINE-} ]] && z4m_remote_install_soft_fail=1

if (( ! ${+functions[_z4m_dependency_get]} )); then
  builtin source -- $Z4M/zsh4monkey/sc/supply-chain || return
fi
local lock_file=$Z4M/zsh4monkey/dependencies.lock

if [[ $1 == */* ]]; then
  repository=${1%%@*}
  owner=${repository%%/*}
  project=${repository#*/}
  if [[ -z $owner || -z $project || $project == */* ||
        $owner == . || $owner == .. || $project == . || $project == .. ||
        $owner == *[^A-Za-z0-9_.-]* || $project == *[^A-Za-z0-9_.-]* ]]; then
    print -Pru2 -- "%F{3}z4m%f: invalid GitHub repository: %F{1}${repository//\%/%%}%f"
    return 1
  fi
  if [[ $repository == zsh-users/zsh-autosuggestions ]]; then
    print -Pru2 -- "%F{3}z4m%f: %Binstall%b: %B$repository%b is built-in; remove this install entry"
    return 1
  fi
  if [[ -n ${Z4M_UPDATING-} &&
        ( -d $Z4M_UPDATING/$repository || -L $Z4M_UPDATING/$repository ) ]] &&
     { [[ $1 != *@* ]] ||
       [[ ${#${1#*@}} != 40 || ${1#*@} == *[^A-Fa-f0-9]* ]]; }; then
    print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: preserving legacy unpinned dependency %B$repository%b"
    print -Pru2 -- "%F{3}z4m%f: migrate it to %B$repository@<commit>%b with a configured SHA-256"
    zf_mkdir -p -- $Z4M/${repository:h} || return
    command cp -RP -- $Z4M_UPDATING/$repository $Z4M/$repository || return
    return 0
  fi
  if [[ $1 == *@* ]]; then
    ref=${1#*@}
    1=${1%%@*}
    if [[ ${#ref} == 40 && $ref != *[^A-Fa-f0-9]* ]]; then
      if _z4m_dependency_get "$lock_file" "$1" && [[ $Z4M_DEPENDENCY_REF == $ref ]]; then
        url=$Z4M_DEPENDENCY_URL
        checksum=$Z4M_DEPENDENCY_SHA256
      else
        url=https://github.com/$1/archive/$ref.tar.gz
        zstyle -s ":z4m:$1" sha256 checksum || checksum=
      fi
    elif ! zstyle -t :z4m:security allow-unverified-downloads; then
      print -Pru2 -- "%F{3}z4m%f: dependency ref must be an exact 40-character commit: %F{1}${ref//\%/%%}%f"
      return 1
    elif [[ -z $ref || $ref == [-/]* || $ref == */ ||
            $ref == *//* || $ref == *..* ||
            $ref == *[^A-Za-z0-9._/-]* ]]; then
      print -Pru2 -- "%F{3}z4m%f: invalid compatibility dependency ref: %F{1}${ref//\%/%%}%f"
      return 1
    else
      url=https://github.com/$1/archive/$ref.tar.gz
      zstyle -s ":z4m:$1" sha256 checksum || checksum=
      print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: downloading unverified compatibility ref %B$1@$ref%b"
    fi
  elif _z4m_dependency_get "$lock_file" "$1"; then
    ref=$Z4M_DEPENDENCY_REF
    url=$Z4M_DEPENDENCY_URL
    checksum=$Z4M_DEPENDENCY_SHA256
  elif zstyle -t :z4m:security allow-unverified-downloads; then
    ref=master
    url=https://github.com/$1/archive/master.tar.gz
    print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: downloading mutable, unverified ref for %B$1%b"
  else
    print -Pru2 -- "%F{3}z4m%f: refusing mutable, unverified dependency %F{1}$1%f"
    print -Pru2 -- "%F{3}z4m%f: use %B$1@<commit>%b and configure %B:z4m:$1 sha256%b"
    return 1
  fi
  if [[ -z $checksum ]] && ! zstyle -t :z4m:security allow-unverified-downloads; then
    print -Pru2 -- "%F{3}z4m%f: missing SHA-256 for %F{1}$1@$ref%f"
    print -Pru2 -- "%F{3}z4m%f: configure %Bzstyle ':z4m:$1' sha256 '<digest>'%b"
    return 1
  fi
  if ! zstyle -s :z4m:$1 postinstall postinstall; then
    case $1 in
      ohmyzsh/ohmyzsh)
        postinstall=-z4m-postinstall-ohmyzsh
      ;;
      MichaelAquilina/zsh-you-should-use)
        postinstall=-z4m-postinstall-zsh-you-should-use
      ;;
      wfxr/forgit)
        postinstall=-z4m-postinstall-forgit
      ;;
      *)
        postinstall=
      ;;
    esac
  fi
else
  local -a channel
  zstyle -a :z4m:$1 channel channel || channel=(stable)
  case $#channel-$channel[1] in
    2-command) command=$channel[2];;
    1-stable|1-testing|1-dev)
      case $1 in
        terminfo|powerlevel10k|zsh-completions)
          if ! _z4m_dependency_get "$lock_file" "$1"; then
            print -Pru2 -- "%F{3}z4m%f: invalid or missing dependency lock for %F{1}$1%f"
            return 1
          fi
          ref=$Z4M_DEPENDENCY_REF
          url=$Z4M_DEPENDENCY_URL
          checksum=$Z4M_DEPENDENCY_SHA256
        ;;
        tmux|fzf|eza|bat|fd|rg|zoxide|carapace|atuin)
          # CLI tools: postinstall checks system command
          url=
        ;;
        zsh-autosuggestions)
          print -Pru2 -- "%F{3}z4m%f: %Binstall%b: %B$1%b is built-in; remove this install entry"
          return 1
        ;;
        *)
          print -Pru2 -- "%F{3}z4m%f: %F{1}internal error%f: unknown package: ${1//\%/%%}"
          return 1
        ;;
      esac
    ;;
    1-none)
      zf_mkdir -p -- $Z4M/$1 || return
      return
    ;;
    *)
      print -Pru2 -- '%F{3}z4m%f: invalid zstyle'
      print -Pru2 -- ''
      print -Pru2 -- "  %F{2}zstyle%f :z4m:${(q)1//\%/%%} channel %F{1}${(j: :)${(@q)channel//\%/%%}}%f"
      print -Pru2 -- ''
      print -Pru2 -- 'Supported values: %Bstable%b, %Btesting%b and %Bdev%b.'
      return 1
    ;;
  esac
  (( $+functions[-z4m-postinstall-$1] )) && postinstall=-z4m-postinstall-$1
fi

if [[ -e $Z4M/.updating ]]; then
  print -Pru2 -- "%F{3}z4m%f: updating %B${1//\%/%%}%b"
else
  print -Pru2 -- "%F{3}z4m%f: installing %B${1//\%/%%}%b"
fi

local dst=$Z4M/$1
local root_path=${Z4M:A}
if [[ ${dst:A} != $root_path/* ]]; then
  print -Pru2 -- "%F{3}z4m%f: refusing dependency path outside %B\$Z4M%b: %F{1}${dst//\%/%%}%f"
  return 1
fi

zf_mkdir -p -- ${dst:h} 2>/dev/null || zf_mkdir -p -- ${dst:h} || return

local old new
local -i old_moved=0 preserve_old=0

{
  if (( $+commands[mktemp] )); then
    old="$(command mktemp -d -- $dst.old.XXXXXXXXXX)" || return
    new="$(command mktemp -d -- $dst.new.XXXXXXXXXX)" || return
  else
    old=$dst.old.$$
    new=$dst.new.$$
    zf_rm -rf -- $old $new   || return
    zf_mkdir -p -- $old $new || return
  fi

  local Z4M_PACKAGE_NAME=$1 Z4M_PACKAGE_DIR=$new/${1:t}

  if [[ -n $command ]]; then
    () { eval $command } || return 1
    if [[ ! -d $Z4M_PACKAGE_DIR ]]; then
      print -Pru2 -- "%F{3}z4m%f: custom command failed to install: %F{1}${Z4M_PACKAGE_DIR//\%/%%}%f"
      return 1
    fi
  elif [[ -z $url ]]; then
    # CLI tools: create directory, postinstall checks system and suggests install
    zf_mkdir -p -- $Z4M_PACKAGE_DIR || return
  else
    local err
    if (( $+commands[curl] )); then
      err="$(command curl --connect-timeout 10 --max-time 120 --retry 2 -fsSL -- $url 2>&1 >$new/snapshot.tar.gz)"
    elif (( $+commands[wget] )); then
      err="$(command wget --timeout=120 --tries=2 -O- -- $url 2>&1 >$new/snapshot.tar.gz)"
    else
      print -Pru2 -- "%F{3}z4m%f: please install %F{1}curl%f or %F{1}wget%f"
      return 1
    fi
    if (( $? )); then
      if (( z4m_remote_install_soft_fail )); then
        [[ -n $err ]] && print -ru2 -- $err
        print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: skipping %B${1//\%/%%}%b during remote %Bssh%b bootstrap"
        print -Pru2 -- "%F{3}z4m%f: failed to download %F{1}${url//\%/%%}%f"
        command rmdir -- ${dst:h} 2>/dev/null || true
        return 0
      fi
      print -ru2 -- $err
      print -Pru2 -- "%F{3}z4m%f: failed to download %F{1}${url//\%/%%}%f"
      return 1
    fi
    if [[ -n $checksum ]] && ! _z4m_verify_sha256 $new/snapshot.tar.gz $checksum; then
      print -Pru2 -- "%F{3}z4m%f: SHA-256 verification failed for %F{1}${url//\%/%%}%f"
      return 1
    fi
    if ! _z4m_archive_safe_p $new/snapshot.tar.gz; then
      print -Pru2 -- "%F{3}z4m%f: unsafe archive content for %F{1}${url//\%/%%}%f"
      return 1
    fi
    if ! command tar -C $new -xzf $new/snapshot.tar.gz; then
      if (( z4m_remote_install_soft_fail )); then
        print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: skipping %B${1//\%/%%}%b during remote %Bssh%b bootstrap"
        print -Pru2 -- "%F{3}z4m%f: invalid archive content for %F{1}${url//\%/%%}%f"
        command rmdir -- ${dst:h} 2>/dev/null || true
        return 0
      fi
      return 1
    fi
    local dirs=($new/*-*(N/))
    if (( $#dirs != 1 )); then
      if (( z4m_remote_install_soft_fail )); then
        print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: skipping %B${1//\%/%%}%b during remote %Bssh%b bootstrap"
        print -Pru2 -- "%F{3}z4m%f: invalid content: %F{1}${url//\%/%%}%f"
        command rmdir -- ${dst:h} 2>/dev/null || true
        return 0
      fi
      print -Pru2 -- "%F{3}z4m%f: invalid content: %F{1}${url//\%/%%}%f"
      return 1
    fi
    if [[ $dirs[1] != $new/${1:t} ]]; then
      -z4m-mv $dirs[1] $new/${1:t} || return
    fi
  fi

  if ! eval $postinstall; then
    if (( z4m_remote_install_soft_fail )) && [[ -n $url ]]; then
      print -Pru2 -- "%F{3}z4m%f: %F{3}warning%f: skipping %B${1//\%/%%}%b during remote %Bssh%b bootstrap"
      command rmdir -- ${dst:h} 2>/dev/null || true
      return 0
    fi
    return 1
  fi

  if [[ -e $dst || -L $dst ]]; then
    -z4m-mv $dst $old/${1:t} 2>/dev/null || return
    old_moved=1
  fi
  if ! -z4m-mv $new/${1:t} $dst; then
    if (( old_moved )) && ! -z4m-mv $old/${1:t} $dst 2>/dev/null; then
      preserve_old=1
      print -Pru2 -- "%F{3}z4m%f: dependency rollback incomplete; backup preserved at %F{1}${old//\%/%%}%f"
    fi
    return 1
  fi
} always {
  [[ -z $new ]] || zf_rm -rf -- $new
  (( preserve_old )) || [[ -z $old ]] || zf_rm -rf -- $old
}
