#!/usr/bin/env zsh
#
# z4m bench - Measure time to the first fully initialized prompt
#
# Usage:
#   z4m bench [count] [--json] [--timeout seconds]

emulate -L zsh -o typeset_silent -o pipe_fail -o no_aliases

local benchmark=$Z4M/zsh4monkey/tools/measure-startup.py
if [[ ! -r $benchmark ]]; then
  print -Pru2 -- "%F{3}z4m%f: missing startup benchmark harness: %F{1}$benchmark%f"
  return 1
fi

local python=${commands[python3]-}
if [[ -z $python ]]; then
  print -Pru2 -- "%F{3}z4m%f: %Bbench%b requires %F{1}python3%f for PTY measurement"
  return 1
fi

local -a args=(--shell $_z4m_exe)
[[ -o login ]] && args+=(--login)

command "$python" "$benchmark" "${args[@]}" "$@"
