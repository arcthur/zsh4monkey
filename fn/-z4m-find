#!/usr/bin/env zsh

# List paths below top-level directories of $PWD for fzf.
# Usage: -z4m-find <dot_glob> <only_dirs> <dir>...
#
# Prints one path per line relative to $PWD (dir/sub/file). The <dir> entries
# themselves are not printed; callers list them separately.
#
# Traversal is bounded: it stays on one filesystem, prunes `find-exclude` names
# and stops at `max-depth` path components (0 means unlimited). fd is preferred
# because it honors .gitignore and lists the first two levels before deeper
# ones, so shallow paths reach fzf first; bfs and find are fallbacks. Setting
# `find-command` or `find-flags` selects the legacy find-compatible pipeline
# instead.

emulate -L zsh -o typeset_silent -o no_aliases -o extended_glob

local dot_glob=$1
local only_dirs=$2
local dirs=("${@:3}")

# File pattern filters (from _path_files -g and -F options). Only
# fzf-complete sets these; "${unset[@]}" would yield one empty pattern.
local -a file_pats=() file_ignore=()
(( ${+_z4m_find_pats} )) && file_pats=("${_z4m_find_pats[@]}")
(( ${+_z4m_find_ignore} )) && file_ignore=("${_z4m_find_ignore[@]}")

# Turn -g values into basename patterns for [[ ]]. Like _path_files, split
# them on blanks. _files joins several patterns as {a,b}, which [[ ]] does not
# expand, so rewrite it as (a|b). A trailing glob qualifier such as (-.) or
# (#q-.) would be a literal group in [[ ]]; strip it and keep only a plain
# file/directory type check.
local -a name_pats=() pat_types=()
() {
  local pat out c type
  local -i depth esc
  for pat in ${${(z):-x ${(j: :)file_pats}}[2,-1]}; do
    type=
    while [[ $pat == (#b)(?*)\((\#q|)([^\#\(\)\|\~][^\(\)\|\~]#|)\) ]]; do
      pat=$match[1]
      [[ $match[3] == (-|)/ ]] && type=d
      [[ $match[3] == (-|). ]] && type=f
    done
    if [[ $pat == *\{*,*\}* ]]; then
      out= depth=0 esc=0
      for c in ${(s::)pat}; do
        if (( esc )); then
          esc=0
        elif [[ $c == \\ ]]; then
          esc=1
        elif [[ $c == \{ ]]; then
          c='('
          (( ++depth ))
        elif [[ $c == \} ]] && (( depth )); then
          c=')'
          (( --depth ))
        elif [[ $c == , ]] && (( depth )); then
          c='|'
        fi
        out+=$c
      done
      (( depth )) || pat=$out
    fi
    name_pats+=("$pat")
    pat_types+=("$type")
  done
}

local widget=${WIDGET#z4m-}
local -a bin flags exclude
local max_depth
() {
  emulate -L zsh
  # Set dot_glob in case these styles depend on it (via `zstyle -e`).
  # Ideally we should run this with user options.
  (( dot_glob )) && setopt dot_glob
  zstyle -a :z4m:$widget find-command bin
  zstyle -a :z4m:$widget find-flags flags
  zstyle -a :z4m:$widget find-exclude exclude || exclude=(.git node_modules)
  zstyle -s :z4m:$widget max-depth max_depth || max_depth=6
}
[[ $max_depth == <-> ]] || max_depth=6

if (( ! $#bin && ! $#flags )); then
  (( max_depth != 1 )) || return 0
  # Excludes do not apply to explicit search roots; drop them here.
  local name
  for name in $exclude; do
    dirs=(${dirs:#${~name}})
  done
  # ~/Library is hidden in Finder and usually outweighs the rest of $HOME.
  if [[ $OSTYPE == darwin* && $PWD -ef $HOME ]] && (( ! dot_glob )); then
    dirs=(${dirs:#Library})
  fi
fi

(( $#dirs )) || return 0

local -a cmd
if (( $#bin || $#flags )); then
  (( $#bin )) || bin=(command find)
  (( $#flags )) || flags=(-name '.*' -prune -print -o -print)
  local -aU fss
  fss=(${(f)"$("${bin[@]}" / . -maxdepth 0 -printf '%F\n' 2>/dev/null)"}) || fss=()
  if (( $#fss )) && [[ -z ${(M)fss:#unknown} ]]; then
    cmd+=("${bin[@]}" -L ./$^dirs)
    (( only_dirs )) && cmd+=('!' -type d -prune -o)
    cmd+=('!' '(')
    local fs
    for fs in $fss; do
      cmd+=(-fstype $fs -o)
    done
    cmd[-1]=(')' -prune '(' "${flags[@]}" ')')
    (( dot_glob )) || cmd+=(-o -name '.*' -prune)
    cmd+=(-o "${flags[@]}")
  else
    cmd+=("${bin[@]}" -L . -xdev -mindepth 1)
    (( only_dirs )) && cmd+=('!' -type d -prune -o)
    cmd+=('!' -path './*/*' '!' '(')
    local dir
    for dir in $dirs; do
      cmd+=(-name ${(b)dir} -o)
    done
    cmd[-1]=(')' -prune)
    (( dot_glob )) || cmd+=(-o -name '.*' -prune)
    cmd+=(-o "${flags[@]}")
  fi
  function -z4m-find-run() { "${cmd[@]}" | command sed -n '/\/.*\// s/^..//p' }
else
  # Depth below the listed directories.
  local -i max=$(( max_depth ? max_depth - 1 : 0 ))
  local fd=
  if (( $+commands[fd] )); then
    fd=fd
  elif (( $+commands[fdfind] )); then
    fd=fdfind
  fi
  cmd=(command $fd --color=never --follow --one-file-system)
  (( dot_glob )) && cmd+=(--hidden)
  (( only_dirs )) && cmd+=(--type=directory)
  cmd+=(--exclude=${^exclude} --search-path=./${^dirs})
  # Probe once so that an fd without these flags degrades to find.
  if [[ -n $fd ]] && "${cmd[@]}" --min-depth=1 --max-depth=1 --max-results=1 &>/dev/null; then
    function -z4m-find-run() {
      # Two walks keep shallow paths first without re-walking every level.
      if (( max > 2 )); then
        "${cmd[@]}" --max-depth=2
        "${cmd[@]}" --min-depth=3 --max-depth=$max
      elif (( max )); then
        "${cmd[@]}" --max-depth=$max
      else
        "${cmd[@]}"
      fi | command sed 's:^\./::; s:/$::'
    }
  else
    cmd=(command find)
    (( $+commands[bfs] )) && cmd=(command bfs)
    cmd+=(-L ./$^dirs -mindepth 1)
    (( max )) && cmd+=(-maxdepth $max)
    cmd+=(-xdev)
    local -a prune=()
    local name
    for name in $exclude; do
      prune+=(-name $name -o)
    done
    (( dot_glob )) || prune+=(-name '.*' -o)
    (( $#prune )) && cmd+=('(' "${(@)prune[1,-2]}" ')' -prune -o)
    (( only_dirs )) && cmd+=(-type d)
    cmd+=(-print)
    function -z4m-find-run() { "${cmd[@]}" | command sed 's:^\./::' }
  fi
fi

{
  if (( $#name_pats || $#file_ignore )); then
    # Filter output through zsh to respect glob patterns
    -z4m-find-run | while IFS= read -r line; do
      local name=${line:t}
      local -i match=1 i
      # Check if file matches any of the include patterns
      if (( $#name_pats )); then
        match=0
        for (( i = 1; i <= $#name_pats; ++i )); do
          [[ $name == ${~name_pats[i]} ]] || continue
          case $pat_types[i] in
            f) [[ -f $line ]] || continue;;
            d) [[ -d $line ]] || continue;;
          esac
          match=1
          break
        done
      fi
      # Check if file matches any ignore pattern
      if (( match && $#file_ignore )); then
        local ign
        for ign in "${file_ignore[@]}"; do
          if [[ $name == ${~ign} ]]; then
            match=0
            break
          fi
        done
      fi
      (( match )) && print -r -- "$line"
    done
  else
    -z4m-find-run
  fi
} always {
  unfunction -- -z4m-find-run
}
