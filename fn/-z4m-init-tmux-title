#!/usr/bin/env zsh
#
# Context-Aware Tmux Window Naming
#
# First Principles Design:
#   - Window name reflects current context (project, git branch, command)
#   - Performance first: no forks per prompt; dirty state reuses p10k's gitstatus result
#   - Non-intrusive: only active inside tmux, graceful degradation
#
# Triggers:
#   chpwd   → Update project/branch context
#   preexec → Show running command with icon
#   precmd  → Restore to project/branch context
#

emulate -L zsh -o typeset_silent

# Check if tmux title feature is enabled
if ! zstyle -T :z4m:tmux-title enable; then
  return 0
fi

# Require tmux environment
[[ -n $TMUX ]] || return 0

# =============================================================================
# Configuration
# =============================================================================
# Read by hooks after this function returns, so it must be global.
typeset -gi _z4m_tmux_title_max_length
zstyle -s :z4m:tmux-title max-length _z4m_tmux_title_max_length || _z4m_tmux_title_max_length=24

# =============================================================================
# Command Icon Mapping (Nerd Fonts)
# =============================================================================
typeset -gA _z4m_cmd_icons=(
  nvim    ''
  vim     ''
  vi      ''
  node    ''
  npm     ''
  npx     ''
  yarn    ''
  pnpm    ''
  bun     ''
  deno    ''
  python  ''
  python3 ''
  pip     ''
  pip3    ''
  docker  ''
  kubectl '󱃾'
  ssh     ''
  mosh    ''
  git     ''
  lazygit ''
  make    ''
  cargo   ''
  rustc   ''
  go      ''
  java    ''
  gradle  ''
  mvn     ''
  lua     ''
  ruby    ''
  gem     ''
  rails   ''
  php     ''
  composer ''
  perl    ''
  awk     ''
  sed     ''
  grep    ''
  rg      ''
  fd      ''
  fzf     ''
  tmux    ''
  zsh     ''
  bash    ''
  fish    ''
  man     ''
  less    ''
  bat     ''
  cat     ''
  top     ''
  htop    ''
  btm     ''
  btop    ''
  ps      ''
  curl    ''
  wget    ''
  rsync   ''
  scp     ''
  tar     ''
  zip     ''
  unzip   ''
  brew    ''
  apt     ''
  yum     ''
  pacman  ''
)

# =============================================================================
# State Variables
# =============================================================================
typeset -g _z4m_tmux_title_context=''
# The enclosing git worktree and its HEAD file, found by -z4m-tmux-project-name.
typeset -g _z4m_tmux_title_git_root='' _z4m_tmux_title_git_head=''

# =============================================================================
# Core: Set tmux window name
# =============================================================================
function -z4m-tmux-set-window-name() {
  # A cd inside $(...) must not leak the escape sequence into captured output.
  (( ZSH_SUBSHELL )) && return
  # Directory names, HEAD contents and command words are untrusted: render
  # control characters visibly so they cannot end the sequence or inject others.
  local name=${(V)1} max=$_z4m_tmux_title_max_length
  # Truncate if too long
  (( max > 0 && ${#name} > max )) && name="${name:0:$((max-1))}…"
  # Use escape sequence (faster, works in nested sessions). Hooks invoked from
  # widgets have stdout redirected, so fall back to the tty fd like -z4m-set-term-title.
  if [[ -t 1 ]]; then
    printf '\033k%s\033\\' "$name"
  elif [[ -v _z4m_tty_fd ]]; then
    printf '\033k%s\033\\' "$name" >&$_z4m_tty_fd 2>/dev/null
  fi
  return 0
}

# =============================================================================
# Git Branch Detection (with dirty indicator)
# =============================================================================
function -z4m-tmux-git-info() {
  [[ -n $_z4m_tmux_title_git_head ]] || return 1

  # HEAD is read on every prompt so that checkouts show up immediately.
  local head=''
  { read -r head <$_z4m_tmux_title_git_head || [[ -n $head ]] } 2>/dev/null || return 1
  if [[ $head == 'ref: '* ]]; then
    REPLY=${${head#ref: }#refs/heads/}
  else
    REPLY=${head:0:8}
  fi

  # Dirty state comes from p10k's latest gitstatus result for this repository
  # (it is refreshed after this hook, so it may lag one prompt). Querying
  # gitstatus here would block the prompt or race p10k's request, and running
  # git would scan the worktree on every prompt.
  if [[ ${VCS_STATUS_RESULT-} == ok-* && ${VCS_STATUS_WORKDIR-} == "$_z4m_tmux_title_git_root" ]] &&
     (( ${VCS_STATUS_NUM_STAGED:-0} > 0 || ${VCS_STATUS_NUM_UNSTAGED:-0} > 0 ||
        ${VCS_STATUS_NUM_UNTRACKED:-0} > 0 )); then
    REPLY+='*'
  fi
  return 0
}

# =============================================================================
# Project Detection
# =============================================================================
# Usage: -z4m-tmux-project-name [find-git]
function -z4m-tmux-project-name() {
  local dir=$PWD m root='' gitdir='' line=''
  local -i scan=1 find_git=${1:-0}
  local -a markers=(.git package.json Cargo.toml go.mod pyproject.toml
                    Makefile CMakeLists.txt build.gradle pom.xml
                    composer.json Gemfile mix.exs deno.json)

  # Walk up the directory tree: project markers below $HOME (falling back to
  # the current directory name) and, if asked, the enclosing git worktree up to /.
  REPLY=${PWD:t}
  while :; do
    [[ $dir == / || $dir == "$HOME" ]] && scan=0
    if (( scan )); then
      for m in $markers; do
        if [[ -e $dir/$m ]]; then
          REPLY=${dir:t}
          scan=0
          break
        fi
      done
    fi
    (( find_git )) && [[ -z $root && -e $dir/.git ]] && root=$dir
    [[ $dir == / ]] && break
    (( scan || (find_git && ! $#root) )) || break
    dir=${dir:h}
  done

  # .git is a directory, or a file pointing to it (worktrees, submodules).
  if [[ -n $root && -d $root/.git ]]; then
    gitdir=$root/.git
  elif [[ -n $root ]] && { read -r line <$root/.git } 2>/dev/null && [[ $line == 'gitdir: '* ]]; then
    gitdir=${line#gitdir: }
    [[ $gitdir == /* ]] || gitdir=$root/$gitdir
  fi

  # p10k queries gitstatus with the resolved directory, so compare resolved paths.
  _z4m_tmux_title_git_root=${root:+${root:A}}
  _z4m_tmux_title_git_head=${gitdir:+$gitdir/HEAD}
}

# =============================================================================
# Build Context Title
# =============================================================================
function -z4m-tmux-build-context() {
  local project branch show_git

  zstyle -t :z4m:tmux-title git-branch && show_git=1 || show_git=0

  # Get project name
  -z4m-tmux-project-name $show_git
  project=$REPLY

  # Get git branch if enabled and in a git repo
  if (( show_git )) && -z4m-tmux-git-info; then
    branch=$REPLY
    REPLY="${project}:${branch}"
  else
    REPLY=$project
  fi
}

# =============================================================================
# Hook: chpwd - Update context on directory change
# =============================================================================
function -z4m-tmux-title-chpwd() {
  emulate -L zsh
  -z4m-tmux-build-context
  _z4m_tmux_title_context=$REPLY
  -z4m-tmux-set-window-name "$_z4m_tmux_title_context"
}

# =============================================================================
# Hook: preexec - Show running command
# =============================================================================
function -z4m-tmux-title-preexec() {
  emulate -L zsh
  local show_icons cmd icon title

  zstyle -t :z4m:tmux-title command-icons && show_icons=1 || show_icons=0

  # Extract first word (command name)
  cmd=${1[(w)1]}
  # Remove path prefix if present
  cmd=${cmd:t}
  # Handle sudo/env/time prefixes
  # zsh 5.10 has no word past the last one; keep the prefix itself then.
  [[ $cmd == (sudo|env|time|nohup|nice|ionice|strace|ltrace) ]] && cmd=${${1[(w)2]:t}:-$cmd}

  if (( show_icons )); then
    icon=${_z4m_cmd_icons[$cmd]:-}
    if [[ -n $icon ]]; then
      title="${icon} ${cmd}"
    else
      title=$cmd
    fi
  else
    title=$cmd
  fi

  -z4m-tmux-set-window-name "$title"
}

# =============================================================================
# Hook: precmd - Restore context after command
# =============================================================================
function -z4m-tmux-title-precmd() {
  emulate -L zsh
  # Rebuild context (git status may have changed)
  -z4m-tmux-build-context
  _z4m_tmux_title_context=$REPLY
  -z4m-tmux-set-window-name "$_z4m_tmux_title_context"
}

# =============================================================================
# Register Hooks
# =============================================================================
autoload -Uz add-zsh-hook

add-zsh-hook chpwd -z4m-tmux-title-chpwd
add-zsh-hook preexec -z4m-tmux-title-preexec
add-zsh-hook precmd -z4m-tmux-title-precmd

# =============================================================================
# Initialize: Set initial context
# =============================================================================
-z4m-tmux-title-chpwd
