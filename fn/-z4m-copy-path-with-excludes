#!/usr/bin/env zsh

emulate -L zsh -o typeset_silent -o pipe_fail -o extended_glob \
    -o prompt_percent -o no_prompt_subst -o no_prompt_bang -o no_bg_nice -o no_aliases

-z4m-copy-path-matches-exclude() {
  emulate -L zsh -o typeset_silent -o pipe_fail -o no_aliases

  local rel=$1
  local exclude_blob=$2
  local pattern

  [[ -n $rel && -n $exclude_blob ]] || return 1
  for pattern in "${(@f)exclude_blob}"; do
    [[ -n $pattern ]] || continue
    if [[ $pattern == */* ]]; then
      [[ $rel == $~pattern ]] && return 0
    else
      [[ ${rel:t} == $~pattern ]] && return 0
    fi
  done
  return 1
}

# Walk the tree once, recording directories to create and, per destination
# directory, the entries to copy into it. Copying then costs one mkdir for the
# whole tree and one cp per directory and entry kind, instead of a mkdir and a
# cp per file. Callers declare dirs, batch_dst, batch_flags and batch_srcs.
-z4m-copy-path-with-excludes-walk() {
  emulate -L zsh -o typeset_silent -o pipe_fail -o extended_glob -o no_aliases

  local src=$1
  local dst=$2
  local mode=$3
  local exclude_blob=$4
  local rel=$5

  dirs+=("$dst")
  local -a entries=($src/*(N) $src/.[^.]*(N) $src/..?*(N))
  local -a files links
  local entry child_rel
  for entry in $entries; do
    child_rel=${rel:+$rel/}${entry:t}
    -z4m-copy-path-matches-exclude "$child_rel" "$exclude_blob" && continue
    if [[ -L $entry ]]; then
      links+=("$entry")
    elif [[ -d $entry ]]; then
      -z4m-copy-path-with-excludes-walk "$entry" "$dst/${entry:t}" "$mode" "$exclude_blob" "$child_rel" || return
    elif [[ -f $entry ]]; then
      files+=("$entry")
    else
      return 1
    fi
  done

  if (( $#files )); then
    batch_dst+=("$dst")
    batch_flags+=(-p)
    batch_srcs+=("${(pj:\0:)files}")
  fi
  if (( $#links )); then
    batch_dst+=("$dst")
    [[ $mode == follow ]] && batch_flags+=(-RLp) || batch_flags+=(-pP)
    batch_srcs+=("${(pj:\0:)links}")
  fi
}

-z4m-copy-path-with-excludes-tree() {
  emulate -L zsh -o typeset_silent -o pipe_fail -o extended_glob -o no_aliases

  local -a dirs batch_dst batch_flags batch_srcs
  -z4m-copy-path-with-excludes-walk "$@" '' || return

  # Chunked to stay well below ARG_MAX on directories with many entries.
  local -i chunk=512 i j
  for (( j = 1; j <= $#dirs; j += chunk )); do
    command mkdir -p -- "${(@)dirs[j,j+chunk-1]}" || return
  done
  local -a srcs
  for (( i = 1; i <= $#batch_dst; ++i )); do
    srcs=("${(@0)batch_srcs[i]}")
    for (( j = 1; j <= $#srcs; j += chunk )); do
      command cp $batch_flags[i] -- "${(@)srcs[j,j+chunk-1]}" "$batch_dst[i]/" || return
    done
  done
}

local src=$1
local dst=$2
local mode=${3:-preserve}
local exclude_blob=${4-}

[[ -n $src && -n $dst ]] || return 1
[[ -e $src || -L $src ]] || return 1
[[ $mode == preserve || $mode == follow ]] || return 1

if [[ -d $src && ! -L $src ]]; then
  -z4m-copy-path-with-excludes-tree "$src" "$dst" "$mode" "$exclude_blob"
  return
fi

-z4m-copy-path-matches-exclude "${src:t}" "$exclude_blob" && return 0
command mkdir -p -- "${dst:h}" || return
if [[ -L $src ]]; then
  if [[ $mode == follow ]]; then
    command cp -RLp -- "$src" "$dst"
  else
    command cp -pP -- "$src" "$dst"
  fi
  return
fi
[[ -f $src ]] || return 1
command cp -p -- "$src" "$dst"
