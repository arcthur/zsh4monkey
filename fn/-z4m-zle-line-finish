#!/usr/bin/env zsh

local -i ret

if [[ -v widgets[-z4m-orig-zle-line-finish] ]]; then
  zle -- -z4m-orig-zle-line-finish "$@" || ret=$?
fi

if [[ -v _z4m_redraw_fd ]]; then
  zle -F "$_z4m_redraw_fd"
  exec {_z4m_redraw_fd}>&-
  unset _z4m_redraw_fd
fi

if [[ $BUFFER == *' ' ]] &&
   ! zstyle -t :z4m:history preserve-trailing-whitespace &&
   -z4m-is-valid-list "$PREBUFFER$BUFFER"; then
  BUFFER=${BUFFER%% #}
fi

# Remember the line for the history_pwd strategy. The history id is assigned
# only once zsh accepts the entry, so the commit is deferred to line-init.
if (( ${+_z4m_dir_history_ids} )); then
  if [[ -n $BUFFER ]] && [[ ! -o hist_ignore_space || $PREBUFFER$BUFFER != ' '* ]]; then
    typeset -g _z4m_dir_history_pending_dir=${(%):-%~}
    typeset -g _z4m_dir_history_pending_text=$PREBUFFER$BUFFER
  else
    unset _z4m_dir_history_pending_dir _z4m_dir_history_pending_text
  fi
fi

-z4m-autosuggest-reset finish
if [[ -v region_highlight ]]; then
  -z4m-highlight-render
fi

# Vi mode: reset cursor to block when command executes
if (( ${+_Z4M_VI_MODE_ENABLED} )); then
  -z4m-set-cursor-shape block
fi

return ret
