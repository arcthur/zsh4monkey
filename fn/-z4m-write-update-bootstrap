#!/usr/bin/env zsh

emulate -L zsh -o typeset_silent -o extended_glob -o no_aliases

(( ARGC == 6 )) || return 1

local output=$1
local root=$2
local guard=$3
local backup=$4
local candidate=$5
local next_bootstrap=$6

print -r -- "#!/usr/bin/env zsh
# Temporary bootstrap while z4m update syncs files in place.
emulate -L zsh -o extended_glob -o no_aliases
[[ -n \${_Z4M_UPDATE_BOOTSTRAP_ACTIVE-} ]] && return 1
typeset -g _Z4M_UPDATE_BOOTSTRAP_ACTIVE=1
typeset -g _z4m_update_root=${(q)root}
typeset -g _z4m_update_guard=${(q)guard}
typeset -g _z4m_update_backup=${(q)backup}
typeset -g _z4m_update_candidate=${(q)candidate}
typeset -g _z4m_update_next=${(q)next_bootstrap}
typeset -g _z4m_update_recovery_lock=${(q)root}/.update-recovery-lock
typeset -i _z4m_update_pid=0
typeset -i _z4m_update_tries=0
typeset -i _z4m_update_recovery_lock_owned=0
function _z4m_update_recover() {
  # The restore algorithm lives in -z4m-recover-update so this bootstrap and
  # -z4m-cmd-update cannot drift apart. The backup is a snapshot of the tree
  # that generated this file, so it carries a matching implementation; the
  # active tree is the fallback once replacement has already completed.
  local directory
  for directory in \\
      \$_z4m_update_backup/zsh4monkey/fn \\
      \$_z4m_update_root/zsh4monkey/fn; do
    [[ -r \$directory/-z4m-recover-update ]] || continue
    builtin unfunction -- -z4m-recover-update 2>/dev/null
    builtin autoload -Uz -- \$directory/-z4m-recover-update 2>/dev/null || continue
    -z4m-recover-update \\
      \$_z4m_update_root \\
      \$_z4m_update_guard \\
      \$_z4m_update_recovery_lock \\
      \$_z4m_update_backup \\
      \$_z4m_update_candidate
    return
  done
  return 1
}
function _z4m_update_release_recovery_lock() {
  (( _z4m_update_recovery_lock_owned )) || return 0
  command rm -rf -- \$_z4m_update_recovery_lock 2>/dev/null || return 1
  _z4m_update_recovery_lock_owned=0
}
function _z4m_update_finish() {
  builtin unfunction -- -z4m-recover-update 2>/dev/null || true
  builtin unfunction \
    _z4m_update_recover \
    _z4m_update_release_recovery_lock \
    _z4m_update_finish 2>/dev/null || true
  unset \
    _Z4M_UPDATE_BOOTSTRAP_ACTIVE \
    _z4m_update_root \
    _z4m_update_guard \
    _z4m_update_backup \
    _z4m_update_candidate \
    _z4m_update_next \
    _z4m_update_recovery_lock \
    _z4m_update_pid \
    _z4m_update_tries \
    _z4m_update_recovery_lock_owned
}
if [[ -r \$_z4m_update_guard ]]; then
  while IFS='=' read -r key value; do
    case \$key in
      pid)
        [[ \$value == <-> ]] && _z4m_update_pid=\$value
      ;;
    esac
  done <\$_z4m_update_guard
fi
while [[ -e \$_z4m_update_guard && _z4m_update_tries -lt 1200 ]]; do
  if (( _z4m_update_pid )) && ! command kill -0 \$_z4m_update_pid 2>/dev/null; then
    break
  fi
  command sleep 0.05 2>/dev/null || break
  (( ++_z4m_update_tries ))
done
if [[ -e \$_z4m_update_guard ]]; then
  if (( _z4m_update_pid )) &&
     ! command kill -0 \$_z4m_update_pid 2>/dev/null; then
    if command mkdir -- \$_z4m_update_recovery_lock 2>/dev/null; then
      _z4m_update_recovery_lock_owned=1
      if ! _z4m_update_recover; then
        _z4m_update_release_recovery_lock 2>/dev/null || true
        _z4m_update_finish
        return 1
      fi
      _z4m_update_release_recovery_lock 2>/dev/null || {
        _z4m_update_finish
        return 1
      }
    else
      _z4m_update_tries=0
      while [[ -e \$_z4m_update_recovery_lock && _z4m_update_tries -lt 400 ]]; do
        command sleep 0.05 2>/dev/null || break
        (( ++_z4m_update_tries ))
      done
      [[ ! -e \$_z4m_update_recovery_lock ]] || {
        _z4m_update_finish
        return 1
      }
    fi
  else
    _z4m_update_finish
    return 1
  fi
fi
if [[ -r \$_z4m_update_next ]]; then
  command mv -f -- \$_z4m_update_next \$_z4m_update_root/z4m.zsh 2>/dev/null || {
    _z4m_update_finish
    return 1
  }
  command rm -rf -- \$_z4m_update_backup \$_z4m_update_candidate 2>/dev/null || true
elif [[ -d \$_z4m_update_backup ]]; then
  if ! command mkdir -- \$_z4m_update_recovery_lock 2>/dev/null; then
    _z4m_update_finish
    return 1
  fi
  _z4m_update_recovery_lock_owned=1
  if ! _z4m_update_recover ||
     ! _z4m_update_release_recovery_lock; then
    _z4m_update_finish
    return 1
  fi
fi
if [[ -r \$_z4m_update_root/z4m.zsh ]]; then
  _z4m_update_finish
  builtin source -- ${root:q}/z4m.zsh || return
  return
fi
_z4m_update_finish
return 1" >$output
