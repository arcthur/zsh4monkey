#!/usr/bin/env zsh

local home=~
local zdotdir=${${${(q)ZDOTDIR}/#${(q)home}/'~'}//\%/%%}
local z4m=${${${(q)Z4M}/#${(q)home}/'~'}//\%/%%}
print -Pru2 -- ''
print -Pru2 -- '%F{3}z4m%f: %B'${1//\%/%%}'%b %F{1}failed%f'
print -Pru2 -- ''
print -Pru2 -- 'See error messages above to identify the culprit.'
print -Pru2 -- ''
print -Pru2 -- 'Edit Zsh configuration:'
print -Pru2 -- ''
print -Pru2 -- '  %F{2}'${(q)${VISUAL:-${EDITOR:-vi}}}'%f %U'$zdotdir'/.zshrc%u'
if [[ $1 != update ]]; then
  print -Pru2 -- ''
  print -Pru2 -- 'Retry Zsh initialization:'
  print -Pru2 -- ''
  print -Pru2 -- '  %U%F{2}exec%u zsh%f'
fi
print -Pru2 -- ''
print -Pru2 -- 'Preserve the current cache before a clean reinstall:'
print -Pru2 -- ''
print -Pru2 -- '  %F{2}mv%f -- %U'$z4m'%u %U'$z4m'.failed.$EPOCHSECONDS%u'
if (( $+commands[curl] )); then
  print -Pru2 -- ''
  print -Pru2 -- 'Download, verify, and run the stable installer:'
  print -Pru2 -- ''
  print -Pru2 -- '  z4m_installer=$(%F{2}mktemp%f)'
  print -Pru2 -- '  %F{2}curl%f -fsSLo "$z4m_installer" %Uhttps://github.com/arcthur/zsh4monkey/releases/latest/download/install%u'
  print -Pru2 -- '  %F{2}gh%f attestation verify "$z4m_installer" --repo arcthur/zsh4monkey \'
  print -Pru2 -- '    --signer-workflow arcthur/zsh4monkey/.github/workflows/release.yml'
  print -Pru2 -- '  %F{2}sh%f "$z4m_installer"'
  print -Pru2 -- '  %F{2}rm%f -f -- "$z4m_installer"'
  print -Pru2 -- ''
elif (( $+commands[wget] )); then
  print -Pru2 -- ''
  print -Pru2 -- 'Download, verify, and run the stable installer:'
  print -Pru2 -- ''
  print -Pru2 -- '  z4m_installer=$(%F{2}mktemp%f)'
  print -Pru2 -- '  %F{2}wget%f -O "$z4m_installer" %Uhttps://github.com/arcthur/zsh4monkey/releases/latest/download/install%u'
  print -Pru2 -- '  %F{2}gh%f attestation verify "$z4m_installer" --repo arcthur/zsh4monkey \'
  print -Pru2 -- '    --signer-workflow arcthur/zsh4monkey/.github/workflows/release.yml'
  print -Pru2 -- '  %F{2}sh%f "$z4m_installer"'
  print -Pru2 -- '  %F{2}rm%f -f -- "$z4m_installer"'
  print -Pru2 -- ''
fi
